# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/loraguard
# Alternative for development: DATABASE_URL=sqlite:///./loraguard.db

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LoRaWAN Configuration
LORA_SERVER_URL=http://localhost:8080
LORA_WEBHOOK_SECRET=your-webhook-secret

# Notification Services
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Twilio (Alternative WhatsApp provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=your_fcm_project_id

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
MAX_EVENTS_PER_PAGE=100
DEBOUNCE_TIME_SECONDS=30
CORRELATION_WINDOW_SECONDS=60
SAFE_HOURS_START=7
SAFE_HOURS_END=21

# Alert Settings
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=300
CRITICAL_ALERT_COOLDOWN_SECONDS=1800
